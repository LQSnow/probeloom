<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ProbeLoom.Presentation.RouteMapPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16,12" RowSpacing="10" Background="{ThemeResource ProbeLoomCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Route Map" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource ProbeLoomCaptionStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Style="{StaticResource ProbeLoomCompactButtonStyle}"
                Click="Refresh_Click"
                Content="刷新" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                QueryIcon="Find"
                PlaceholderText="按名称或 Route 搜索"
                TextChanged="Filter_Changed" />
            <ComboBox
                x:Name="MethodFilter"
                Grid.Column="1"
                SelectionChanged="Filter_Changed" />
            <ComboBox
                x:Name="GroupFilter"
                Grid.Column="2"
                SelectionChanged="Filter_Changed" />
            <CheckBox
                x:Name="ShowCasesCheckBox"
                Grid.Column="3"
                VerticalAlignment="Center"
                Content="显示 Request Case"
                IsChecked="True"
                Checked="Filter_Changed"
                Unchecked="Filter_Changed" />
        </Grid>
        <ListView
            x:Name="EntriesList"
            Grid.Row="2"
            IsItemClickEnabled="True"
            ItemClick="EntriesList_ItemClick"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="52" Padding="6,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            Text="{Binding Method}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding Kind}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding RouteTemplate}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding ExampleUrl}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GroupDisplay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding Authentication}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource ProbeLoomDangerBrush}"
                            Text="{Binding Status}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
