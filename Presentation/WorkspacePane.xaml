<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ProbeLoom.Presentation.WorkspacePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="WorkspaceNodeTemplate">
            <Grid
                MinWidth="150"
                MinHeight="28"
                ColumnSpacing="7"
                RightTapped="WorkspaceRow_RightTapped"
                AutomationProperties.Name="{Binding Content.AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="13"
                    Glyph="{Binding Content.Glyph}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding Content.Name}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    Grid.Column="2"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ProbeLoomSubtleFillBrush}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="9"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Content.KindLabel}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{ThemeResource ProbeLoomSidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="12,10,8,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="7">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE8F1;"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        x:Name="ProjectNameText"
                        MaxWidth="185"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="未打开项目"
                        TextTrimming="CharacterEllipsis" />
                    <Ellipse
                        x:Name="DirtyDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource ProbeLoomWarningBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="ProjectPathText"
                    MaxWidth="190"
                    Style="{StaticResource ProbeLoomCaptionStyle}"
                    Text="新建或打开本地项目"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Name="ProjectMenuButton"
                Grid.Column="2"
                Style="{StaticResource ProbeLoomSubtleIconButtonStyle}"
                AutomationProperties.Name="项目操作"
                Click="ProjectMenu_Click"
                Content="&#xE712;"
                ToolTipService.ToolTip="项目操作" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource ProbeLoomCaptionStyle}"
                FontWeight="SemiBold"
                Text="工作区结构" />
            <Button
                Grid.Column="1"
                Style="{StaticResource ProbeLoomSubtleIconButtonStyle}"
                AutomationProperties.Name="新建根分组"
                Click="AddRootGroup_Click"
                Content="&#xE710;"
                ToolTipService.ToolTip="新建根分组" />
        </Grid>

        <Grid Grid.Row="2">
            <TreeView
                x:Name="WorkspaceTree"
                Margin="4,0,4,8"
                AllowDrop="False"
                ItemTemplate="{StaticResource WorkspaceNodeTemplate}"
                ItemInvoked="WorkspaceTree_ItemInvoked"
                SelectionMode="Single" />

            <StackPanel
                x:Name="EmptyStatePanel"
                Width="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Visible">
                <FontIcon
                    FontSize="28"
                    Glyph="&#xE838;"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    x:Name="EmptyTitleText"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="还没有工作区内容" />
                <TextBlock
                    x:Name="EmptyDescriptionText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ProbeLoomCaptionStyle}"
                    Text="先创建分组，再在其中添加 Endpoint。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyActionButton"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ProbeLoomCompactButtonStyle}"
                    Click="AddRootGroup_Click"
                    Content="新建分组" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
