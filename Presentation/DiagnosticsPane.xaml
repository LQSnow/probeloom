<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ProbeLoom.Presentation.DiagnosticsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ProbeLoomSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="14,0,8,0"
            BorderBrush="{ThemeResource ProbeLoomSoftStrokeBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource ProbeLoomSectionTitleStyle}" Text="Response" />
                <Border
                    Padding="7,2"
                    Background="{ThemeResource ProbeLoomSubtleFillBrush}"
                    CornerRadius="9">
                    <TextBlock
                        x:Name="StatusText"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Text="尚未发送" />
                </Border>
                <TextBlock x:Name="StatusCodeText" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                <TextBlock x:Name="DurationText" Style="{StaticResource ProbeLoomCaptionStyle}" />
                <TextBlock x:Name="SizeText" Style="{StaticResource ProbeLoomCaptionStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Style="{StaticResource ProbeLoomSubtleIconButtonStyle}"
                AutomationProperties.Name="清空会话历史"
                Click="Clear_Click"
                Content="&#xE74D;"
                ToolTipService.ToolTip="清空本次会话历史" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,0" BorderBrush="{ThemeResource ProbeLoomSoftStrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="BodyTab" Style="{StaticResource ProbeLoomSectionTabStyle}" Click="Tab_Click" Content="Body" IsChecked="True" />
                <ToggleButton x:Name="HeadersTab" Style="{StaticResource ProbeLoomSectionTabStyle}" Click="Tab_Click" Content="Headers" />
                <ToggleButton x:Name="RawTab" Style="{StaticResource ProbeLoomSectionTabStyle}" Click="Tab_Click" Content="Raw" />
                <ToggleButton x:Name="RedirectsTab" Style="{StaticResource ProbeLoomSectionTabStyle}" Click="Tab_Click" Content="Redirects" />
                <ToggleButton x:Name="HistoryTab" Style="{StaticResource ProbeLoomSectionTabStyle}" Click="Tab_Click" Content="History" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="14,6,14,12">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="22"
                    Glyph="&#xE9D9;"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyTitleText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="尚无响应" />
                <TextBlock
                    x:Name="EmptyDescriptionText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ProbeLoomCaptionStyle}"
                    Text="校验通过后，按 Ctrl+Enter 发送当前请求。"
                    TextAlignment="Center" />
            </StackPanel>

            <TextBox
                x:Name="OutputTextBox"
                AcceptsReturn="True"
                AutomationProperties.Name="响应内容"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                Visibility="Collapsed"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <ListView
                x:Name="HistoryList"
                IsItemClickEnabled="True"
                ItemClick="HistoryList_ItemClick"
                SelectionMode="Single"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="38" Padding="4,2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Text="{Binding Status}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding Time}" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource ProbeLoomCaptionStyle}" Text="{Binding Duration}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
