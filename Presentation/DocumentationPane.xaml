<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ProbeLoom.Presentation.DocumentationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource ProbeLoomCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="API Documentation" />
            <ComboBox
                x:Name="ScopeComboBox"
                Grid.Row="1"
                Header="Preview scope"
                DisplayMemberPath="Label"
                SelectionChanged="ScopeComboBox_SelectionChanged" />
            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="8">
                    <TextBox x:Name="SummaryTextBox" Header="Summary" PlaceholderText="Endpoint summary" />
                    <TextBox
                        x:Name="DescriptionTextBox"
                        Header="Description"
                        AcceptsReturn="True"
                        MinHeight="100"
                        TextWrapping="Wrap" />
                    <TextBox x:Name="TagsTextBox" Header="Tags" PlaceholderText="auth, users" />
                    <CheckBox x:Name="DeprecatedCheckBox" Content="Deprecated" />
                    <TextBlock
                        Style="{StaticResource ProbeLoomCaptionStyle}"
                        Text="字段说明可在 Params、Path 与 Headers 行的后续扩展入口中维护；当前格式已支持保存与导出。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Button
                Grid.Row="3"
                HorizontalAlignment="Left"
                Style="{StaticResource AccentButtonStyle}"
                Click="ApplyMetadata_Click"
                Content="应用文档元数据" />
        </Grid>
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource ProbeLoomCompactButtonStyle}" Click="Copy_Click" Content="复制 Markdown" />
                <Button Style="{StaticResource ProbeLoomCompactButtonStyle}" Click="Export_Click" Content="导出 .md" />
            </StackPanel>
            <TextBox
                x:Name="MarkdownTextBox"
                Grid.Row="1"
                AcceptsReturn="True"
                AutomationProperties.Name="Markdown preview"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</UserControl>
