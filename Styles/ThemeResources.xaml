<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ProbeLoomCanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ProbeLoomSidebarBrush" Color="#F8F8F8" />
            <SolidColorBrush x:Key="ProbeLoomSurfaceBrush" Color="#FDFDFD" />
            <SolidColorBrush x:Key="ProbeLoomRaisedSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ProbeLoomSubtleFillBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="ProbeLoomSoftStrokeBrush" Color="#12000000" />
            <SolidColorBrush x:Key="ProbeLoomStrongStrokeBrush" Color="#24000000" />
            <SolidColorBrush x:Key="ProbeLoomSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="ProbeLoomWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="ProbeLoomDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="ProbeLoomVariableBrush" Color="#5B2ABF" />
            <SolidColorBrush x:Key="ProbeLoomVariableFillBrush" Color="#145B2ABF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ProbeLoomCanvasBrush" Color="#202020" />
            <SolidColorBrush x:Key="ProbeLoomSidebarBrush" Color="#252525" />
            <SolidColorBrush x:Key="ProbeLoomSurfaceBrush" Color="#292929" />
            <SolidColorBrush x:Key="ProbeLoomRaisedSurfaceBrush" Color="#303030" />
            <SolidColorBrush x:Key="ProbeLoomSubtleFillBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ProbeLoomSoftStrokeBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ProbeLoomStrongStrokeBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="ProbeLoomSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="ProbeLoomWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="ProbeLoomDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="ProbeLoomVariableBrush" Color="#C8A7FF" />
            <SolidColorBrush x:Key="ProbeLoomVariableFillBrush" Color="#24C8A7FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ProbeLoomCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ProbeLoomSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ProbeLoomSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ProbeLoomRaisedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ProbeLoomSubtleFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ProbeLoomSoftStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ProbeLoomStrongStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ProbeLoomSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProbeLoomWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProbeLoomDangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ProbeLoomVariableBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ProbeLoomVariableFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="ProbeLoomControlHeight">32</x:Double>
    <x:Double x:Key="ProbeLoomCompactControlHeight">28</x:Double>
    <CornerRadius x:Key="ProbeLoomCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="ProbeLoomPagePadding">14</Thickness>
</ResourceDictionary>
