<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ProbeLoomCompactButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomSubtleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource ProbeLoomCompactControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ProbeLoomCompactControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ProbeLoomDangerButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Foreground" Value="{ThemeResource ProbeLoomDangerBrush}" />
    </Style>

    <Style x:Key="ProbeLoomCompactTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Padding" Value="8,6,8,2" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomCompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomControlHeight}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomCompactPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomCompactControlHeight}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomInlineTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ProbeLoomCompactControlHeight}" />
        <Setter Property="Padding" Value="6,3,6,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ProbeLoomSoftStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProbeLoomSectionTabStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProbeLoomCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ProbeLoomSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProbeLoomSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ProbeLoomRaisedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ProbeLoomSoftStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ProbeLoomCardCornerRadius}" />
    </Style>
</ResourceDictionary>
